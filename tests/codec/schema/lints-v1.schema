family lint-fixture 1

record HostTool {
    inspect: bool
    modify: bool
    shell: bool
    agents: bool
    max_tokens: u32
    payload: bytes 10000
}

record Boundless {
    count: u32
}

record Payload {
    data: bytes 4
}

record OtherPayload {
    value: u8
}

enum Shared {
    first: Payload
    second: Payload
    other: OtherPayload
    empty
}

record OneByteItems {
    items: list 4 Shared
}
