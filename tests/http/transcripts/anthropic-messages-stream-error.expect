header anthropic-organization-id "9b0f4c1e-2d7a-4b6e-8f3c-5a1d2e9b7c40"
header via "1.1 google"
header cf-cache-status "DYNAMIC"
header X-Robots-Tag "none"
header Server "cloudflare"
header CF-RAY "9872a4c19e3b6f0d-LHR"
framing chunked
event "message_start" "{\"type\":\"message_start\",\"message\":{\"id\":\"msg_01Qd8G2qkVx3Hn7RZmJcT5aE\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-sonnet-4-5-20250929\",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":31,\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":0,\"output_tokens\":1}}}"
