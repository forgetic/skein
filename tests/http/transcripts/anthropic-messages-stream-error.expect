# Written by hand after the published format of Anthropic's Messages API
# (streaming, server-sent events): no real response can be captured offline.
# An error mid-stream: the response began as 200, so the overload comes as an
# `error` event among the others, and the stream ends after it. To the reader
# it is one more event; what it means is the protocol layer's.
# Drafted by the reference readers, then checked by hand.
status HTTP/1.1 200
header Date "Sat, 03 Oct 2026 11:40:07 GMT"
header Content-Type "text/event-stream; charset=utf-8"
header Transfer-Encoding "chunked"
header Connection "keep-alive"
header Cache-Control "no-cache"
header anthropic-ratelimit-requests-limit "4000"
header anthropic-ratelimit-requests-remaining "3998"
header anthropic-ratelimit-requests-reset "2026-10-03T11:40:07Z"
